# Python
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store

# Research data and large artifacts (root-only; do not hide Python packages such
# as src/drill_ir/data/ from Git).
/data/
/checkpoints/
/artifacts/
/outputs/
/embeddings/

# Results are local by default. The runner creates this directory as needed;
# commit selected small artifacts explicitly with `git add -f`.
/results/*

# Slides: keep only rendered PDFs visible to Git
/slides/*
!/slides/*.pdf

# Notebook state
.ipynb_checkpoints/
