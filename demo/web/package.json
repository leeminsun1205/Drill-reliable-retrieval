{
  "name": "drill-legal-qa-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsc src/state.ts --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck --outDir .test-build && node --test tests/state.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "playwright": "1.56.1",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  }
}
